#version 450
#extension GL_ARB_separate_shader_objects : enable

#define WORKGROUP_SIZE 32
#define NUM_BLADES 1 << 20
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraBufferObject {
    mat4 view;
    mat4 proj;
    vec3 cameraPosition;
    float padding;  // Align to 16 bytes
} camera;

layout(set = 1, binding = 0) uniform Time {
    float deltaTime;
    float totalTime;
};

struct Blade {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 up;
};

layout(set = 2, binding = 0) buffer InputBlades {
    Blade blades[];
};

layout(set = 2, binding = 1) buffer CulledBlades {
    Blade culledBlades[];
};

// Indirect draw buffer
layout(set = 2, binding = 2) buffer NumBlades {
    uint vertexCount;
    uint instanceCount; // = 1
    uint firstVertex;   // = 0
    uint firstInstance; // = 0
} numBlades;

// Physics parameters (std140 layout - vec3 aligned to 16 bytes)
layout(set = 3, binding = 0) uniform PhysicsParams {
    float gravityStrength;
    vec3 windDirection;
    float windStrength;
    float windFrequency;
    float turbulenceStrength;
    float orientationThreshold;
    float frustumTolerance;
    float maxDistance;
    float numBuckets;
    uint activeBladeCount;
    uint enableOrientationCulling;
    uint enableViewFrustumCulling;
    uint enableDistanceCulling;
} physics;

bool inBounds(float value, float bounds) {
    return (value >= -bounds) && (value <= bounds);
}

void main() {
	uint index = gl_GlobalInvocationID.x;

    // Reset the indirect draw count (only first thread does this)
    if (index == 0) {
        numBlades.vertexCount = 0;
        numBlades.instanceCount = 1;
        numBlades.firstVertex = 0;
        numBlades.firstInstance = 0;
    }

    // Synchronize to ensure reset completes before any thread increments
    barrier();

    if (index >= physics.activeBladeCount) {
        return;
    }

    Blade blade = blades[index];

    vec3 v0 = blade.v0.xyz;
    vec3 v1 = blade.v1.xyz;
    vec3 v2 = blade.v2.xyz;
    vec3 up = blade.up.xyz;

    float orientation = blade.v0.w;
    float height = blade.v1.w;
    float width = blade.v2.w;
    float stiffness = blade.up.w;

    vec3 theta = normalize(vec3(-cos(orientation), 0.0, sin(orientation)));

    // Gravity
    vec3 f = cross(theta, up);
    float fLen = length(f);
    if (fLen > 0.0001) {
        f = f / fLen;
    } else {
        f = vec3(1.0, 0.0, 0.0);  // Fallback direction
    }
    vec3 gE = vec3(0.0, -physics.gravityStrength, 0.0);
    vec3 gF = 0.25 * length(gE) * f;
    vec3 gravity = gE + gF;

    // Recovery
    vec3 iv2 = v0 + up * height;
    vec3 recoveryForce = (iv2 - v2) * stiffness;

    
    // Wind force: drag-based model with spatial and temporal variation
    vec3 windDirection = normalize(physics.windDirection);
    float windMagnitude = physics.windStrength;

    // Spatial variation: create wind gusts that vary across the field
    vec2 spatialCoord = v0.xz * 0.08;
    float gust1 = sin(spatialCoord.x * 4.2 + totalTime * 0.7);
    float gust2 = cos(spatialCoord.y * 3.1 + totalTime * 0.5);
    float gustStrength = 0.6 + 0.4 * gust1 * gust2;

    // Turbulence component
    float turbFreq = physics.windFrequency;
    float turbAmp = physics.turbulenceStrength;
    vec3 turbulence;
    turbulence.x = sin(totalTime * turbFreq * 1.2 + v0.x * 0.15);
    turbulence.y = 0.0;
    turbulence.z = cos(totalTime * turbFreq * 0.85 + v0.z * 0.15);
    turbulence *= turbAmp;

    // Combined wind velocity
    vec3 windVel = windDirection * windMagnitude * gustStrength + turbulence;

    // Calculate effectiveness: wind pushes blade sideways
    // When blade already points in wind direction, effect is minimal
    float windMag = length(windVel);
    vec3 windForce = vec3(0.0);

    if (windMag > 0.001) {  // Avoid division by zero
        vec3 bladeDir = v2 - v0;
        float bladeDirLen = length(bladeDir);

        if (bladeDirLen > 0.0001) {  // Avoid normalizing zero-length vector
            vec3 bladeOrientation = bladeDir / bladeDirLen;
            vec3 windNormalized = windVel / windMag;

            float alignment = dot(bladeOrientation, windNormalized);
            float sidewaysEffect = 1.0 - abs(alignment);  // Max when perpendicular

            // Height factor: taller blades catch more wind
            float bladeHeight = dot(v2 - v0, up);
            float heightRatio = bladeHeight / height;

            windForce = windVel * sidewaysEffect * heightRatio;
        }
    }

    vec3 totalForce = gravity + recoveryForce + windForce;

    v2 += totalForce * deltaTime;

    // State validation from paper
    // Keep blade above ground
    v2 = v2 - up * min(dot(up, v2 - v0), 0.0);

    // Adjust v1 pos based on proj
    float lProj = length(v2 - v0 - up * dot(up, v2 - v0));
    if (height > 0.0001) {
        v1 = v0 + height * up * max(1.0 - lProj / height, 0.05 * max(lProj / height, 1.0));
    } else {
        v1 = v0 + up * 0.5;  // Default to halfway up
    }

    // Maintain arc length
    float L0 = length(v2 - v0);
    float L1 = length(v1 - v0) + length(v2 - v1);
    float L = (2.0 * L0 + L1) / 3.0;

    // Scale to maintain height
    // Prevent division by zero
    float r = (L > 0.0001) ? (height / L) : 1.0;
    vec3 temp = v1;
    v1 = v0 + r * (v1 - v0);
    v2 = v1 + r * (v2 - temp);

    blade.v1.xyz = v1;
    blade.v2.xyz = v2;
    blades[index] = blade;

    // Culling tests
    bool culled = false;

    vec3 cameraPos = camera.cameraPosition;

    // Orientation culling
    if (physics.enableOrientationCulling != 0) {
        vec3 viewVec = cameraPos - v0;
        float viewVecLen = length(viewVec);
        if (viewVecLen > 0.0001) {
            vec3 viewDir = viewVec / viewVecLen;
            if (abs(dot(theta, viewDir)) > physics.orientationThreshold) {
                culled = true;
            }
        }
    }

    // View-frustum culling
    if (physics.enableViewFrustumCulling != 0) {
        vec4 clipV0 = camera.proj * camera.view * vec4(v0, 1.0);
        vec4 clipV2 = camera.proj * camera.view * vec4(v2, 1.0);

        // Prevent division by zero in perspective divide
        if (abs(clipV0.w) < 0.0001 || abs(clipV2.w) < 0.0001) {
            culled = true;
        } else {
            vec3 ndcV0 = clipV0.xyz / clipV0.w;
            vec3 ndcV2 = clipV2.xyz / clipV2.w;

            float tolerance = physics.frustumTolerance;

            bool outsideLeft = (ndcV0.x < -1.0 - tolerance) && (ndcV2.x < -1.0 - tolerance);
            bool outsideRight = (ndcV0.x > 1.0 + tolerance) && (ndcV2.x > 1.0 + tolerance);
            bool outsideBottom = (ndcV0.y < -1.0 - tolerance) && (ndcV2.y < -1.0 - tolerance);
            bool outsideTop = (ndcV0.y > 1.0 + tolerance) && (ndcV2.y > 1.0 + tolerance);
            bool outsideNear = (ndcV0.z < -1.0 - tolerance) && (ndcV2.z < -1.0 - tolerance);
            bool outsideFar = (ndcV0.z > 1.0 + tolerance) && (ndcV2.z > 1.0 + tolerance);

            if (outsideLeft || outsideRight || outsideBottom || outsideTop || outsideNear || outsideFar) {
                culled = true;
            }
        }
    }

    // Distance culling
    if (physics.enableDistanceCulling != 0) {
        float distanceToCamera = length(cameraPos - v0);

        if (distanceToCamera > physics.maxDistance) {
            culled = true;
        } else if (physics.maxDistance > 0.0001 && physics.numBuckets > 0.0) {
            int bucketIndex = int(floor(physics.numBuckets * distanceToCamera / physics.maxDistance));
            bucketIndex = min(bucketIndex, int(physics.numBuckets) - 1);

            float hash = fract(sin(dot(v0.xz ,vec2(12.9898,78.233))) * 43758.5453);
            float cullThreshold = 1.0 - (float(bucketIndex) / physics.numBuckets);

            if (hash > cullThreshold) {
                culled = true;
            }
        }
    }

    if (!culled) {
        uint outIndex = atomicAdd(numBlades.vertexCount, 1);
        culledBlades[outIndex] = blade;
    }

    /*
    culledBlades[index] = blade;

    if (gl_GlobalInvocationID.x == 0) {
        numBlades.vertexCount = NUM_BLADES;
        numBlades.instanceCount = 1;
        numBlades.firstVertex = 0;
        numBlades.firstInstance = 0;
    }
    */
}
