#version 450
#extension GL_ARB_separate_shader_objects : enable

#define WORKGROUP_SIZE 32
#define NUM_BLADES 8192
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraBufferObject {
    mat4 view;
    mat4 proj;
} camera;

layout(set = 1, binding = 0) uniform Time {
    float deltaTime;
    float totalTime;
};

struct Blade {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 up;
};

layout(set = 2, binding = 0) buffer InputBlades {
    Blade blades[];
};

layout(set = 2, binding = 1) buffer CulledBlades {
    Blade culledBlades[];
};

// Indirect draw buffer
layout(set = 2, binding = 2) buffer NumBlades {
    uint vertexCount;
    uint instanceCount; // = 1
    uint firstVertex;   // = 0
    uint firstInstance; // = 0
} numBlades;

// Physics parameters (std140 layout - vec3 aligned to 16 bytes)
layout(set = 3, binding = 0) uniform PhysicsParams {
    float gravityStrength;
    // padding[3] in C++ for alignment
    vec3 windDirection;
    float windStrength;
    float windFrequency;
    float turbulenceStrength;
} physics;

bool inBounds(float value, float bounds) {
    return (value >= -bounds) && (value <= bounds);
}

void main() {
	uint index = gl_GlobalInvocationID.x;
    if (index >= NUM_BLADES) {
        return;
    }

    Blade blade = blades[index];

    vec3 v0 = blade.v0.xyz;
    vec3 v1 = blade.v1.xyz;
    vec3 v2 = blade.v2.xyz;
    vec3 up = blade.up.xyz;

    float orientation = blade.v0.w;
    float height = blade.v1.w;
    float width = blade.v2.w;
    float stiffness = blade.up.w;

    // Use physics parameters from uniform buffer
    // Apply gravity with environmental factor (0.25)
    vec3 gE = vec3(0.0, -physics.gravityStrength, 0.0);
    vec3 gF = gE;

    vec3 iv2 = v0 + up * height;

    vec3 recoveryForce = (iv2 - v2) * stiffness;

    vec3 windDir = normalize(physics.windDirection);
    float theta = orientation;
    vec3 bladeDirection = vec3(sin(theta), 0.0, cos(theta));

    float alignment = max(0.0, dot(windDir, normalize(v2 - v0)));

    vec3 windDirectional = windDir * physics.windStrength * alignment;

    float freq = physics.windFrequency;
    float turbStr = physics.turbulenceStrength;

    float noiseX = sin(totalTime * freq + v0.x * 0.5) * cos(totalTime * freq * 0.7);
    float noiseZ = cos(totalTime * freq + v0.z * 0.5) * sin(totalTime * freq * 0.9);

    vec3 windTurbulence = vec3(noiseX, 0.0, noiseZ) * turbStr;

    vec3 windForce = windDirectional + windTurbulence;

    vec3 totalForce = gF + recoveryForce + windForce;

    // v2 cannot go below ground
    vec3 v2_new = v2 + totalForce * deltaTime;
    v2_new = v2_new - up * min(dot(up, v2_new - v0), 0.0);

    // blade length cannot exceed height
    float currentLength = length(v2_new - v0);
    if (currentLength > height) {
        v2_new = v0 + normalize(v2_new - v0) * height;
    }

    vec3 v1_new = v0 + height * up * 0.5 + (v2_new - v0) * 0.5;

    blade.v1.xyz = v1_new;
    blade.v2.xyz = v2_new;

    culledBlades[index] = blade;

    if (gl_GlobalInvocationID.x == 0) {
        numBlades.vertexCount = NUM_BLADES;
        numBlades.instanceCount = 1;
        numBlades.firstVertex = 0;
        numBlades.firstInstance = 0;
    }
}

